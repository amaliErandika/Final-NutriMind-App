<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Scroll view -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <!-- Bubble Icon Container -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/iconContainer"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginBottom="24dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/txtTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Center Icon -->
                <ImageView
                    android:id="@+id/iconCenter"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/emoji_happy"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:contentDescription="Happy Face" />

                <!-- Top Thinking Emoji -->
                <ImageView
                    android:id="@+id/iconTop"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/emoji_thinking"
                    app:layout_constraintBottom_toTopOf="@id/iconCenter"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:contentDescription="Thinking Face" />

                <!-- Right Surprised Emoji -->
                <ImageView
                    android:id="@+id/iconRightSurprised"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="12dp"
                    android:src="@drawable/emoji_surprised"
                    app:layout_constraintStart_toEndOf="@id/iconCenter"
                    app:layout_constraintTop_toTopOf="@id/iconCenter"
                    android:contentDescription="Surprised Face" />

                <!-- Right Angry Emoji -->
                <ImageView
                    android:id="@+id/iconRightAngry"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="64dp"
                    android:src="@drawable/emoji_angry"
                    app:layout_constraintBottom_toBottomOf="@id/iconCenter"
                    app:layout_constraintStart_toEndOf="@id/iconCenter"
                    android:contentDescription="Angry Face" />

                <!-- Left Sad Emoji -->
                <ImageView
                    android:id="@+id/iconLeftSad"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="20dp"
                    android:src="@drawable/emoji_sad"
                    app:layout_constraintBottom_toBottomOf="@id/iconCenter"
                    app:layout_constraintEnd_toStartOf="@id/iconCenter"
                    android:contentDescription="Sad Face" />

                <!-- Top Right Love Emoji -->
                <ImageView
                    android:id="@+id/iconTopRightLove"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/emoji_love_small"
                    app:layout_constraintStart_toEndOf="@id/iconCenter"
                    app:layout_constraintTop_toTopOf="parent"
                    android:contentDescription="Loving Face" />

                <!-- Bottom Left Holy Emoji -->
                <ImageView
                    android:id="@+id/iconBottomLeftExtra"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/emoji_holy"
                    app:layout_constraintEnd_toStartOf="@id/iconCenter"
                    app:layout_constraintTop_toBottomOf="@id/iconCenter"
                    android:contentDescription="Blessed Face" />

                <!-- Bottom Center Sleepy Emoji -->
                <ImageView
                    android:id="@+id/iconBottomSleepy"
                    android:layout_width="113dp"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:src="@drawable/emoji_sleepy"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.608"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/iconCenter"
                    android:contentDescription="Sleepy Face" />

                <!-- Bottom Left Not Well Emoji -->
                <ImageView
                    android:id="@+id/iconBottomLeftNotWell"
                    android:layout_width="86dp"
                    android:layout_height="60dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="28dp"
                    android:src="@drawable/emoji_notwell"
                    app:layout_constraintEnd_toStartOf="@id/iconCenter"
                    app:layout_constraintTop_toTopOf="@id/iconBottomSleepy"
                    android:contentDescription="Unwell Face" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Content Section -->
            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="we're starting now, here we go on this journey!"
                android:textSize="24sp"
                android:textColor="#000000"
                android:textStyle="bold"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                app:layout_constraintTop_toBottomOf="@id/iconContainer"
                app:layout_constraintBottom_toTopOf="@+id/txtSubtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/txtSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                android:text="Your journey toward a brighter, healthier, and more joyful life begins today."
                android:textSize="16sp"
                android:textColor="#757575"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/txtTitle"
                app:layout_constraintBottom_toTopOf="@+id/btnStart"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="20dp"
                android:text="Explore NutriMind"
                android:textColor="@color/white"
                android:textAllCaps="false"
                app:backgroundTint="@color/my_primary"
                app:cornerRadius="30dp"
                app:layout_constraintTop_toBottomOf="@id/txtSubtitle"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>